# default config 默认配置
# 服务器监听地址
# 但请确保服务器有足够的安全措施，防止未授权访问
# 测试用，本地访问
#HOST=127.0.0.1
# 服务器ip，部署时使用
HOST=0.0.0.0
# 可视化URL，自己电脑的ip或服务器域名
URL=127.0.0.1
# HTTP 端口
HTTP_PORT=8787
# MCP 端口
MCP_PORT=8000
# 数据库路径
DB_PATH=data/air_quality.sqlite

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 认证和权限控制配置
## 是否启用认证和权限控制 (True/False)
# True: 启用完整的认证和权限控制，需要用户登录和权限验证
# False: 禁用认证，所有工具无需权限即可使用（适用于测试环境）
ENABLE_AUTH=False

# 达梦数据库配置
# 数据库服务器地址
DM_HOST=127.0.0.1
# 数据库端口
DM_PORT=5236
# 数据库名称
DM_DATABASE=DAMENG
# 数据库用户名
DM_USERNAME=SYSDBA
# 数据库密码
DM_PASSWORD=your_password_here
# 数据库模式名
DM_SCHEMA=auth
# 连接池配置
DM_POOL_SIZE=10
DM_MAX_OVERFLOW=20
DM_POOL_TIMEOUT=30
DM_POOL_RECYCLE=3600
# 连接超时时间（秒）
DM_CONNECT_TIMEOUT=10
# 是否启用达梦数据库（True/False）
DM_ENABLED=True

# JWT认证配置
# JWT签名密钥（生产环境请使用强随机密钥）
JWT_SECRET_KEY=your-secret-key-change-me-in-production
# JWT Token过期时间（分钟）
JWT_TOKEN_EXPIRE_MINUTES=60

# Dify聊天服务器配置，关闭权限不需要配置
CHAT_URL=http://your-dify-server/chat/your-app-id

# 天地图配置
TIANDITU_TK=your_tianditu_token_here
